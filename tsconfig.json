{
  "compilerOptions": {
    "module": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2017",
    "strict": true,
    "moduleResolution": "Node16",
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
