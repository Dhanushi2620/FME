{
  "name": "fme",
  "version": "1.0.0",
  "description": "Feedback Memory Engine — persistent engineering memory for Cursor AI",
  "private": true,
  "scripts": {
    "build:hook": "tsc --project tsconfig.hook.json",
    "build": "tsc --project tsconfig.json",
    "memories": "tsc --project tsconfig.scripts.json && node dist/scripts/showMemories.js",
    "verify:retrieval": "npm run build && node dist/retrieval/selection/runSelectionVerification.js",
    "start:mcp": "node dist/mcp/startMcpServer.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "redis": "^6.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
